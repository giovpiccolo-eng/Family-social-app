# --- Claude API ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model used for the daily run (good quality/cost balance for long-form).
# Bump to claude-opus-4-8 for max quality, or claude-haiku-4-5-20251001 for speed/cost.
BRIEF_MODEL=claude-sonnet-4-6

# --- Email (Gmail SMTP) ---
# Use a Gmail App Password, NOT your normal password:
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
GMAIL_USER=giovpiccolo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the brief is sent (defaults to GMAIL_USER if omitted)
BRIEF_TO=giovpiccolo@gmail.com

# Optional: set FORCE=1 to bypass the send-time guard (useful for manual test runs)
# FORCE=1
