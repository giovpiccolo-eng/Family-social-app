rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shared family photos. Any signed-in user may read/write under a family path.
    // (Firestore holds the authoritative membership; tighten here if you need
    //  per-family isolation in Storage as well.)
    match /families/{familyId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
