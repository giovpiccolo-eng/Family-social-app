rules_version = '2';

// Storage layout: audio/{schoolId}/{teacherId}/{observationId}.webm
//                 photos/{schoolId}/{teacherId}/{observationId}/{photoId}.jpg
//                 sis/{schoolId}/rosters/{filename}.csv
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function schoolMatches(schoolId) {
      return signedIn() && request.auth.token.schoolId == schoolId;
    }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isPrincipal() {
      return signedIn() && (
        request.auth.token.role == 'principal' || request.auth.token.role == 'admin'
      );
    }

    match /audio/{schoolId}/{teacherId}/{file} {
      allow read: if schoolMatches(schoolId);
      allow write: if isPrincipal() && schoolMatches(schoolId)
        && request.resource.size < 500 * 1024 * 1024;
    }

    match /photos/{schoolId}/{teacherId}/{observationId}/{file} {
      allow read: if schoolMatches(schoolId);
      allow write: if isPrincipal() && schoolMatches(schoolId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /sis/{schoolId}/{path=**} {
      allow read: if schoolMatches(schoolId);
      allow write: if isAdmin() && schoolMatches(schoolId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
