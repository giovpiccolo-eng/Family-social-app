<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_warm">

    <TextView
        android:id="@+id/tvStepNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1 of 5"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="5"
        android:progress="0"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/progress_track"
        android:layout_marginBottom="28dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbarStyle="insideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="44sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvClue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/hint_background"
                android:padding="14dp"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnHint"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Show Hint"
        android:textSize="13sp"
        android:backgroundTint="@color/hint_btn"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnTakePhoto"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="📷  TAKE PHOTO"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent" />

</LinearLayout>
